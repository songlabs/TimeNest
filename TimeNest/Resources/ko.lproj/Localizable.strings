"help.shifts.multiple.answer" = "같은 날에는 하나의 근무만 유지됩니다. 이미 근무가 있는 날에 다른 근무를 선택하면 기존 근무가 교체되지만 일반 일정이나 출근・퇴근 기록은 삭제되지 않습니다.";
"help.shifts.replace.question" = "당일 근무를 변경하려면?";
"help.shifts.replace.answer" = "근무 입력을 다시 열고 같은 날짜를 선택한 다음 새 근무를 누르면 교체됩니다. 취소 버튼은 선택한 날짜의 근무만 삭제하며 다른 일정에는 영향을 주지 않습니다.";
"help.shifts.change_time.question" = "근무 시간을 사용자 설정하려면?";
"help.shifts.change_time.answer" = "설정의 근무 시간 사용자 설정에서 주간, 야간 및 사용자 지정 근무의 이름, 시작 시간, 종료 시간과 색상을 변경할 수 있습니다. 변경 내용은 이후에 생성하는 근무에 적용됩니다.";
"help.shifts.difference.question" = "근무와 출퇴근 기록은 어떻게 다른가요?";
"help.shifts.difference.answer" = "근무는 주간이나 야간 같은 예정된 근무 일정을 뜻합니다. 출퇴근 기록은 실제 출근・퇴근 시간, 휴게 시간, 시급 및 교통비를 기록한 정보이며 근무 통계에 사용됩니다.";
"help.shifts.record.question" = "출근과 퇴근을 기록하려면?";
"help.shifts.record.answer" = "일정을 추가하거나 편집할 때 출근 시간, 퇴근 시간, 휴게 시간, 시급 및 교통비를 입력할 수 있습니다. 저장한 정보는 출퇴근 기록으로 통계에 반영됩니다.";
"help.shifts.overnight.question" = "다음 날 퇴근은 어떻게 처리되나요?";
"help.shifts.overnight.answer" = "야간 근무처럼 날짜를 넘기는 경우 퇴근 시간을 다음 날로 기록할 수 있습니다. 통계에서는 출근부터 다음 날 퇴근까지의 실제 시간에서 휴게 시간을 빼서 계산합니다.";
"help.shifts.statistics.question" = "근무 통계는 어떻게 계산되나요?";
"help.shifts.statistics.answer" = "근무 통계는 기록된 출근 시간, 퇴근 시간, 휴게 시간, 시급 및 교통비를 기준으로 계산합니다. 기본 계산식은 근무 시간 = 퇴근 시간 - 출근 시간 - 휴게 시간, 급여 = 근무 시간 × 시급, 합계 = 급여 + 교통비입니다.";
"help.shifts.statistics_missing.question" = "통계 결과가 표시되지 않는 이유는?";
"help.shifts.statistics_missing.answer" = "선택한 기간에 출근과 퇴근 기록이 저장되어 있고 시급 등 필요한 정보가 입력되어 있는지 확인하세요. 근무 일정만으로는 급여 통계가 자동 생성되지 않습니다.";

