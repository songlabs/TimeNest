"help.shifts.add.question" = "근무조를 추가하려면?";
"help.shifts.add.answer" = "달력 위쪽 메뉴에서 근무조 입력을 열고 날짜를 선택한 다음 근무조 버튼을 누르세요. 추가한 근무조는 월・주・일 보기에 표시됩니다.";
"help.shifts.multiple.question" = "하루에 여러 근무조를 추가할 수 있나요?";
"help.shifts.multiple.answer" = "같은 날에는 하나의 근무조만 유지됩니다. 이미 근무조가 있는 날에 다른 근무조를 선택하면 기존 근무조가 교체되지만 일반 일정이나 출근・퇴근 기록은 삭제되지 않습니다.";
"help.shifts.replace.question" = "당일 근무조를 변경하려면?";
"help.shifts.replace.answer" = "근무조 입력을 다시 열고 같은 날짜를 선택한 다음 새 근무조를 누르면 교체됩니다. 취소 버튼은 선택한 날짜의 근무조만 삭제하며 다른 일정에는 영향을 주지 않습니다.";
"help.shifts.change_time.question" = "근무조 시간을 사용자 설정하려면?";
"help.shifts.change_time.answer" = "설정의 근무조 시간 사용자 설정에서 주간, 야간 및 사용자 지정 근무조의 이름, 시작 시간, 종료 시간과 색상을 변경할 수 있습니다. 변경 내용은 이후에 생성하는 근무조에 적용됩니다.";
"help.shifts.difference.question" = "근무조와 근무 기록은 어떻게 다른가요?";
"help.shifts.difference.answer" = "근무조는 주간이나 야간 같은 예정된 근무 일정을 뜻합니다. 근무 기록은 실제 출근・퇴근 시간, 휴게 시간, 시급 및 교통비를 기록한 정보이며 근무 통계에 사용됩니다.";
"help.shifts.record.question" = "출근과 퇴근을 기록하려면?";
"help.shifts.record.answer" = "날짜 상세에서 근무 기록 새로 만들기를 열거나 새로 만들기 화면에서 근무 기록을 선택한 뒤 출근 시간, 퇴근 시간, 휴게 시간, 시급 및 교통비를 입력합니다. 저장한 내용은 근무 통계에 반영됩니다.";
"help.shifts.overnight.question" = "다음 날 퇴근은 어떻게 처리되나요?";
"help.shifts.overnight.answer" = "야간 근무처럼 날짜를 넘기는 경우 퇴근 시간을 다음 날로 기록할 수 있습니다. 통계에서는 출근부터 다음 날 퇴근까지의 실제 시간에서 휴게 시간을 빼서 계산합니다.";
"help.shifts.statistics.question" = "근무 통계는 어떻게 계산되나요?";
"help.shifts.statistics.answer" = "근무 통계는 기록된 출근 시간, 퇴근 시간, 휴게 시간, 시급 및 교통비를 기준으로 계산합니다. 모든 금액은 일본 엔(JPY)입니다. 기본 계산식은 근무 시간 = 퇴근 시간 - 출근 시간 - 휴게 시간, 급여 = 근무 시간 × 시급, 합계 = 급여 + 교통비입니다.";
"help.shifts.statistics_missing.question" = "통계 결과가 표시되지 않는 이유는?";
"help.shifts.statistics_missing.answer" = "선택한 기간에 출근과 퇴근 기록이 저장되어 있고 시급 등 필요한 정보가 입력되어 있는지 확인하세요. 근무조만으로는 급여 통계가 자동 생성되지 않습니다.";

"help.sharing.create.question" = "공유 캘린더를 만들거나 편집하려면?";
"help.sharing.create.answer" = "캘린더 왼쪽 위 아이콘을 누르고 공유 캘린더 만들기를 선택하세요. 이름을 입력하고 만들기를 누르면 iCloud 공유 화면이 열립니다. 만든 뒤에는 연필 버튼으로 이름을 바꾸고 사람 추가에서 초대를 보낼 수 있습니다.";
"help.sharing.accept.question" = "공유 초대를 수락하려면?";
"help.sharing.accept.answer" = "iCloud에 로그인한 기기에서 초대 링크를 열고 공유를 수락하세요. iCloud 또는 CloudKit을 사용할 수 없는 기기에서는 초대를 수락하지 못할 수 있습니다. 수락하거나 새로고침한 데이터가 표시되기까지 잠시 걸릴 수 있습니다.";
"help.sharing.switch.question" = "표시할 캘린더를 전환하려면?";
"help.sharing.switch.answer" = "캘린더 왼쪽 위 아이콘을 누르고 내 캘린더 또는 공유 캘린더 하나를 선택하세요. 체크 표시는 현재 표시 중인 캘린더를 뜻합니다. 한 번에 하나의 캘린더만 표시됩니다.";
"help.sharing.copy.question" = "공유 캘린더의 내용을 내 캘린더에 복사할 수 있나요?";
"help.sharing.copy.answer" = "네. 공유 캘린더 세부 정보 화면에서 ‘내 캘린더에 복사’를 선택한 다음 ‘전체’ 또는 ‘기간 지정’을 선택할 수 있습니다. 기간을 지정하면 시작일과 종료일이 모두 범위에 포함됩니다. 복사하기 전에 덮어쓰기 확인이 표시되며, 내 캘린더에서 선택한 범위의 일정, 근무조 및 근무 기록은 삭제되고 공유 캘린더의 내용으로 대체됩니다. 범위 밖의 데이터는 유지됩니다. 복사한 내용은 공유 캘린더와 계속 동기화되지 않는 별도의 로컬 사본이며, 원본 공유 캘린더는 변경되지 않습니다. 이 작업은 되돌릴 수 없습니다. 받은 공유 캘린더의 동기화가 아직 끝나지 않았다면 일시적으로 복사할 수 없으므로 새로고침한 뒤 동기화가 완료될 때까지 기다렸다가 다시 시도하세요.";
"help.sharing.read_only_holidays.question" = "공유 캘린더를 편집할 수 있나요? 공휴일은 어떻게 표시되나요?";
"help.sharing.read_only_holidays.answer" = "받은 공유 캘린더는 기본적으로 보기 전용입니다. 소유자가 일정 편집을 허용하고 받는 사람의 iCloud/CloudKit 참여 권한이 읽기 및 쓰기인 경우에만 일정을 추가, 편집 또는 삭제할 수 있습니다. 받는 사람은 근무조와 근무 기록을 추가, 편집 또는 삭제할 수 없습니다. 공휴일은 CloudKit으로 공유되지 않으며 받는 사람의 기기에서 활성화한 지역과 로컬 캐시에 따라 표시됩니다.";
"help.sharing.content.question" = "공유되는 내용과 공유되지 않는 내용은?";
"help.sharing.content.answer" = "현재 해당 공유 캘린더의 일정, 근무조 및 근무 기록은 자동으로 공유되며 종류별로 끌 수 없습니다. 일정 제목과 시간, 근무 기록의 출근・퇴근 및 휴게 시간은 공유됩니다. 메모, 미리 알림과 알림, 음성 입력 내용, 시급, 급여, 교통비, 근무조 템플릿, 설정 및 광고 제거 구입 상태는 공유되지 않습니다.";
"help.sharing.stop.question" = "공유를 중단하거나 삭제하면 어떻게 되나요?";
"help.sharing.stop.answer" = "소유자가 공유를 중단하거나 공유 캘린더를 삭제하면 받는 사람은 더 이상 해당 캘린더를 볼 수 없습니다. 받는 사람이 공유에서 나가면 자신의 기기 목록에서만 제거되며 소유자의 데이터에는 영향이 없습니다. 변경 내용이 보이지 않으면 캘린더 선택 화면에서 새로고침하세요.";

"help.ads.about.question" = "광고 안내";
"help.ads.about.answer" = "동의 흐름에서 광고 요청이 허용되면 TimeNest에 광고가 표시될 수 있습니다. 설정에서 일회성 구입으로 광고를 제거할 수 있고, 구입 복원으로 Apple 구입 상태를 확인할 수 있습니다.";

"help.privacy.storage.question" = "데이터는 어디에 저장되나요?";
"help.privacy.storage.answer" = "일정, 근무조, 근무 기록, 표시 설정 및 공휴일 설정은 이 기기에 저장됩니다. Widget 표시에 필요한 캘린더 정보는 같은 기기의 App Group 안에서만 공유됩니다.";
"help.privacy.account.question" = "계정이 필요한가요?";
"help.privacy.account.answer" = "TimeNest를 사용하는 데 계정 등록이나 로그인이 필요하지 않습니다. TimeNest가 운영하는 클라우드 동기화는 없으며, 공유 캘린더는 Apple iCloud(CloudKit)를 사용합니다.";
"help.privacy.delete_app.question" = "App을 삭제한 경우의 데이터";
"help.privacy.delete_app.answer" = "App을 삭제하면 일반적인 iOS 동작에 따라 기기에 저장된 TimeNest 데이터도 삭제됩니다.";
"help.privacy.options.action" = "광고 개인정보 옵션 관리";
"help.privacy.options.description" = "이 기기의 광고 개인정보 선택을 확인하거나 변경합니다.";
"help.privacy.options.error_title" = "개인정보 옵션을 열 수 없음";
